	(text "FLYOUTS"
		(exclude_from_sim no)
		(at 42.418 151.638 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "0ae8db3f-7b47-41e6-a086-70f244e556b6")
	)
	(text "The 6525 line is controlled\nby the TED PLA \"F0\" line.\nROM banking is done by\nthe computer."
		(exclude_from_sim no)
		(at 56.642 104.394 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0bcc7223-615f-45c0-beee-db73eb407418")
	)
	(text "This is a Speech Dev Board for 264 Series.\nIt uses either the C64 Magic Voice (MV) chips, or the V364 chips.\nWith MV it uses the TPI, Gate Array, and Speech chip from an\noriginal MV unit. It also has a socket for the 8706 Custom Gate\nArray recreation.\n\nThe board connects to one of the TED ROM sockets and that\nROM is relocated to this board. The V364 Speech ROM is\ninstalled on this board (or a patched ROM if required).\n\nOn the TED motherboard the PLA \"F0\" line and the Speech\nROM chip select must be connected to this board.\n\nAudio output should be wired to the\nEXT_AUDIO line of the Cartridge Port.\n"
		(exclude_from_sim no)
		(at 13.97 258.572 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0bd571a3-76fa-42ba-8c51-e03dd293d2dc")
	)
	(text "This circuit is similar to what is\nincluded in the V364's custom Gate Array.\n"
		(exclude_from_sim no)
		(at 128.27 130.556 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.508)
				(bold yes)
			)
			(justify left)
		)
		(uuid "1195128c-6b97-49af-beb1-bf78a86abe8c")
	)
	(text "This is the SPEECH ROM\nfrom a real V364."
		(exclude_from_sim no)
		(at 224.282 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "14c7ad26-d9eb-4862-90ce-f0cfd0983d74")
	)
