	(text "This is the custom gate array only found\nin the Magic Voice. You will not find a\nreplacement but there is a recreation\nproject that hopefully works well enough\nto use here."
		(exclude_from_sim no)
		(at 133.858 106.172 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "46651672-2ebf-406f-ac08-af0fec2ab625")
	)
	(text "This is the 8706 Custom Gate Array. It was\ndeveloped specifically for the V364 and\nwhen the machine was cancelled Commodore\nre-purposed and adapted the design for use\nin the C64 using the MOS TPI and\noff-the-shelf GI Logic Array."
		(exclude_from_sim no)
		(at 211.582 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
