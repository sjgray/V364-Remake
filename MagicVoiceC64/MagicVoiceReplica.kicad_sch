	(text "This is the 6525 Tri-Port Interface chip.\nIt was used in a few Commodore products\nlike the CBM-II computers, the C64 IEEE\ncartridge, Amiga CDTV, and A570. They are\nrare, but it might be possible to find one\nor perhaps the design might be able to\nuse an INTEL 8255."
		(exclude_from_sim no)
		(at 130.048 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "e1b9d428-2963-4c2c-a39a-3c776195a977")
	)
