	(text "This is a replica PCB for the Commodore Magic Voice.\nReverse-engineered schematics were used, as well as\npictures of the top and bottom of the board.\n\nSince the original Toshiba T6721A speech chip, and\nthe LA05-124 chip are no longer available this board\nwill only be useful for people with damaged pcb's or\nas the basis for adapting the design for another\ntarget platform (like say, Commodore V364/TED etc)."
		(exclude_from_sim no)
		(at 15.24 261.112 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0bd571a3-76fa-42ba-8c51-e03dd293d2dc")
	)
